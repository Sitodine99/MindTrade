<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- Vista Colapsada -->
    <LinearLayout
        android:id="@+id/collapsedView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/typeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/symbolTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Símbolo"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/entryPriceTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrada"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/exitPriceTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salida"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/swapTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swap"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/commissionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comisión"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/profitTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beneficio"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <!-- Vista Expandida -->
    <LinearLayout
        android:id="@+id/expandedView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="4dp">

        <TextView
            android:id="@+id/entryDateTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha entrada: "
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/exitDateTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha salida: "
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tradingStyleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estilo de trading: "
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/emotionalStateTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado emocional: "
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/emotionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emoción: "
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/commentsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comentario: "
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/photosLinkTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver fotos"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
