<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Campo de título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/strategyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduce el título de la estrategia" />

        <!-- Campo de descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/strategyDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Describe tu estrategia"
            android:minLines="4"
            android:gravity="top|start" />

        <!-- Estilo de trading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estilo de trading (selecciona uno o varios)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/tradingStyleCheckBoxGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/tradingStyleDayTrading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day Trading" />

            <CheckBox
                android:id="@+id/tradingStyleScalping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scalping" />

            <CheckBox
                android:id="@+id/tradingStyleSwingTrading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Swing Trading" />
        </LinearLayout>


        <!-- Indicadores -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indicadores"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Grupo para los chips dinámicos -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/indicatorChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleLine="false"
            app:chipSpacing="8dp" />


        <com.google.android.material.chip.ChipGroup
            android:id="@+id/predefinedIndicatorChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacing="8dp"
            app:singleLine="false" />

        <!-- Añadir nuevo indicador -->
        <EditText
            android:id="@+id/addIndicatorEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nuevo indicador"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/addIndicatorButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Añadir indicador"
            android:layout_marginTop="8dp" />

        <!-- Temporalidades -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temporalidades (opcional)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="2"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/timeM1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M1" />

            <CheckBox
                android:id="@+id/timeM3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M3" />

            <CheckBox
                android:id="@+id/timeM5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M5" />

            <CheckBox
                android:id="@+id/timeM15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M15" />

            <CheckBox
                android:id="@+id/timeM30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M30" />

            <CheckBox
                android:id="@+id/timeH1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H1" />

            <CheckBox
                android:id="@+id/timeH4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H4" />

            <CheckBox
                android:id="@+id/timeD1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D1" />

            <CheckBox
                android:id="@+id/timeW1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="W1" />

            <CheckBox
                android:id="@+id/timeMN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MN" />
        </GridLayout>

        <!-- Trading Algorítmico -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trading Algorítmico (opcional)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/tradingAlgorithmCode"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:hint="Pega el código en MQL5 aquí"
            android:gravity="top|start"
            android:background="@drawable/code_editor_background"
            android:padding="8dp"
            android:scrollbars="vertical|horizontal"
            android:overScrollMode="always"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />


        <!-- Imagen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <!-- Botón de subir imagen -->
            <ImageButton
                android:id="@+id/uploadImageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Subir Imagen"
                android:src="@drawable/ic_upload"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="16dp" />

            <!-- Vista previa de la imagen -->
            <ImageView
                android:id="@+id/strategyImageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="Vista previa de la imagen"
                android:src="@drawable/ic_placeholder"
                android:scaleType="centerCrop"
                android:background="@drawable/code_editor_background"
                android:layout_marginStart="16dp" />
        </LinearLayout>


        <!-- Botones para guardar y cancelar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
