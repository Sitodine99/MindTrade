<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Estilo de Trading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estilo de Trading"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tradingStyleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estilos seleccionados"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Indicadores -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indicadores"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/strategyIndicatorsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Indicadores seleccionados"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Temporalidades -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temporalidades"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/strategyTimeframesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temporalidades seleccionadas"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Símbolos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Símbolos"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/strategySymbolsTextViewTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Símbolos seleccionados"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Valoración -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valoración"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RatingBar
            android:id="@+id/strategyRatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:isIndicator="true" />

        <TextView
            android:id="@+id/strategySuccessRateTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Porcentaje de éxito: -%"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Número total de operaciones -->
        <TextView
            android:id="@+id/strategyTotalMovementsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Operaciones registradas: -"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <!-- Número de operaciones Buy -->
        <TextView
            android:id="@+id/strategyBuyMovementsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Operaciones Buy: -"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <!-- Número de operaciones Sell -->
        <TextView
            android:id="@+id/strategySellMovementsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Operaciones Sell: -"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <!-- Símbolo más utilizado -->
        <TextView
            android:id="@+id/strategyMostUsedSymbolTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Símbolo más utilizado: -"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>


    </LinearLayout>
</ScrollView>
