<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen del avatar -->
        <ImageView
            android:id="@+id/avatarImageView"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_placeholder"
            android:scaleType="centerCrop"
            android:layout_marginBottom="16dp" />

        <!-- Título de la estrategia -->
        <TextView
            android:id="@+id/strategyTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título de la Estrategia"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Autor de la estrategia -->
        <TextView
            android:id="@+id/strategyAuthorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Por: Autor"
            android:gravity="center"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/strategyDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción de la estrategia"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Indicadores -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indicadores"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/strategyIndicatorsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Indicadores de la estrategia"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Temporalidades -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temporalidades"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/strategyTimeframesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temporalidades utilizadas"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Valoración -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valoración"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RatingBar
            android:id="@+id/strategyRatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:isIndicator="true" />
    </LinearLayout>
</ScrollView>
