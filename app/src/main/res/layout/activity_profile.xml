<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileActivity"
    android:visibility="invisible"> <!-- Oculta la UI inicialmente -->

    <!-- Imagen de fondo -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/buildings_image_description"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/edificios" />

    <!-- Contenedor de información -->
    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título -->
        <TextView
            android:id="@+id/profileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_profile"
            android:textColor="#070707"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileAvatar"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:src="@drawable/interrogacion"
            android:padding="5dp"
            app:shapeAppearanceOverlay="@style/CircularImage"
            app:strokeColor="@android:color/black"
            app:strokeWidth="5dp"
            android:layout_marginBottom="15dp"/>

        <!-- Alias -->
        <TextView
            android:id="@+id/profileAlias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_alias"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#070707"
            android:layout_marginBottom="5dp"/>

        <!-- Correo electrónico -->
        <TextView
            android:id="@+id/profileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_email"
            android:textSize="16sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="20dp"/>

        <!-- Datos de Trading -->
        <TextView
            android:id="@+id/profileTradingStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trading_style"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#070707"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/profilePsicoState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/psico_state"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#070707"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/profileEmotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emotion_state"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#070707"
            android:layout_marginBottom="20dp"/>

        <!-- Sección de Estadísticas -->
        <TextView
            android:id="@+id/profileAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edad: --"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/profileStrategies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estrategias publicadas: --"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/profileAccounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuentas creadas: --"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/profileTrades"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nº de operaciones: --"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/profileComments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nº de comentarios: --"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/profileAverageRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valoración media: --"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/profileFavoriteAsset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activo favorito: --"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="5dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
