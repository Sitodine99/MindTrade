<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.MindTrade" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Personaliza el tema aquí -->

        <!-- Color de la barra de estado (superior) a negro -->
        <item name="android:statusBarColor">@color/black</item>
        <!-- Iconos claros en la barra de estado (para que los iconos sean blancos) -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Color de la barra de navegación (inferior) a negro -->
        <item name="android:navigationBarColor">@color/black</item>
        <!-- Iconos claros en la barra de navegación (para que los iconos sean blancos) -->
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Tema principal que extiende el tema base -->
    <style name="Theme.MindTrade" parent="Base.Theme.MindTrade" />
</resources>
