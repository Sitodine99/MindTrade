<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Estilo circular para ShapeableImageView -->
    <style name="CircularImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item> <!-- Hace que la imagen se muestre como circular -->
    </style>

    <!-- Estilo para las tarjetas -->
    <style name="CustomCardStyle">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/black</item>
        <item name="android:layout_width">324dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
    </style>


</resources>
